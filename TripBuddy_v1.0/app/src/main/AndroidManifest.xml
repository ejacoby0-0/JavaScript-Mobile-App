<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo_tripbuddy"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_tripbuddy_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TripBuddy_v10">

        <activity
            android:name=".Aesthetics.FullScreenImageActivity"
            android:exported="false" />
        <activity
            android:name=".Home_Page.HomePageActivity"
            android:exported="false" />

        <!-- SPLASH is now the launcher -->
        <activity
            android:name=".Aesthetics.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Trip_Planning.TripPlanningActivity"
            android:exported="false" />
        <activity
            android:name=".Memory_Creation.MemoryActivity"
            android:exported="false" />
        <activity
            android:name=".Gallery_View.GalleryActivity"
            android:exported="false" />

        <!-- MAIN is now just a normal activity -->
        <activity
            android:name=".Registraction.MainActivity"
            android:exported="false" />

    </application>

</manifest>